# Anthropic API key (get one at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Server port
PORT=3000

# Email notification (any SMTP provider — Gmail, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=barhashtech@gmail.com
SMTP_PASS=your-smtp-password
SMTP_FROM=barhashtech@gmail.com
LEAD_NOTIFY_EMAIL=barhashtech@gmail.com

# Google Sheets (create a Google Cloud service account, share the sheet with its email)
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
