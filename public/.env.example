# Google Gemini API key (get one free at aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...

# Server port
PORT=3000

# Email notification (any SMTP provider — Gmail, SendGrid, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=you@example.com
LEAD_NOTIFY_EMAIL=sales@yourcompany.com

# Google Sheets (create a Google Cloud service account, share the sheet with its email)
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
